# Postgres Database
POSTGRES_USER=churn_user
POSTGRES_PASSWORD=churn_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=churn_db
CHURN_DB_URL=postgresql://churn_user:churn_pass@localhost:5432/churn_db

# Airflow DB
AIRFLOW_DB=airflow
AIRFLOW_DB_URL=postgresql://churn_user:churn_pass@localhost:5432/airflow

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=customer_churn_prediction

# MinIO (S3-compatible Artifact Store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_DEFAULT_REGION=us-east-1

# Evidently Drift Configuration
DRIFT_PSI_THRESHOLD=0.1
DRIFT_P_VALUE_THRESHOLD=0.05

# Phase 4: Anomaly Notifications & Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ALERT_WEBHOOK_URL=https://api.example.com/alerts/webhook
DASHBOARD_URL=http://localhost:8501
HIGH_RISK_THRESHOLD_PCT=35.0

# Phase 5: Cloud Deployment & Terraform (AWS)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
TF_VAR_environment=dev
TF_VAR_container_image=ghcr.io/alokkr00/customer-churn-pipeline/serving:latest
